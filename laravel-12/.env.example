APP_NAME="Aplikasi Laundry"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laundry_ukk
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="laundry@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Pengaturan Aplikasi Laundry ---
APP_LAB_NAME="LaundryKu"
APP_CITY=Jakarta
PAJAK_DEFAULT=11
PAJAK_NAMA=PPN
INVOKE_PREFIX=INV
INVOKE_REMARKS=5
LAUNDRY_DEFAULT_OUTLET="LaundryKu Pusat"
LAUNDRY_ADMIN_USERNAME=admin
LAUNDRY_ADMIN_PASSWORD=
LAUNDRY_KASIR_USERNAME=kasir
LAUNDRY_KASIR_PASSWORD=
LAUNDRY_OWNER_USERNAME=owner
LAUNDRY_OWNER_PASSWORD=
